# Copiá este archivo como .env y completá los valores.
# El .env real no se sube al repositorio (está en .gitignore).

# --- Base de datos MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=club_deportivo
DB_USER=app_user
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=root_password
DB_SCHEMA_PATH=database/init_db.sql

# --- Servidor Flask ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# --- Seguridad ---
# Clave usada por Flask para firmar sesiones. Cambiala por una clave larga y aleatoria.
SECRET_KEY=cambiar-esta-clave-por-una-aleatoria