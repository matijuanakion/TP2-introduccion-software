        {
          "name": "Listar reservas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservas?id_cancha=1&id_socio=1&estado=confirmada&fecha_desde=2026-10-01&fecha_hasta=2026-10-31&_limit=10&_offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["reservas"],
              "query": [
                { "key": "id_cancha", "value": "1" },
                { "key": "id_socio", "value": "1" },
                { "key": "estado", "value": "confirmada" },
                { "key": "fecha_desde", "value": "2026-10-01" },
                { "key": "fecha_hasta", "value": "2026-10-31" },
                { "key": "_limit", "value": "10" },
                { "key": "_offset", "value": "0" }
              ]
            },
            "description": "Los filtros son opcionales; se pueden quitar desde Params."
