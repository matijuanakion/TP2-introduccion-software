        {
          "name": "Crear reserva",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_socio\": 1,\n  \"id_cancha\": 1,\n  \"fecha_hora_inicio\": \"2026-10-15T18:00:00.000000-03:00\",\n  \"fecha_hora_fin\": \"2026-10-15T20:00:00.000000-03:00\"\n}",
              "options": { "raw": { "language": "json" } }
