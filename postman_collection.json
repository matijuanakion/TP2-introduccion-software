{
  "info": {
    "_postman_id": "a1435f72-f6a2-4fda-9e16-8db11c11a500",
    "name": "API Club Deportivo - TP2",
    "description": "Colección para probar la API de reservas del Club Deportivo. Cambiá baseUrl si usás otro host o puerto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000", "type": "string" },
    { "key": "idCancha", "value": "1", "type": "string" },
    { "key": "idSocio", "value": "1", "type": "string" },
    { "key": "idReserva", "value": "1", "type": "string" },
    { "key": "idBloqueo", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Deportes",
      "item": [
        {
          "name": "Listar deportes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/deportes",
            "description": "Lista los deportes precargados."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Canchas",
      "item": [
        {
          "name": "Listar canchas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/canchas?id_deporte=1&nombre=Cancha&techada=false&activa=true&_limit=10&_offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["canchas"],
              "query": [
                { "key": "id_deporte", "value": "1", "description": "Filtrar por deporte" },
                { "key": "nombre", "value": "Cancha", "description": "Búsqueda parcial por nombre" },
                { "key": "techada", "value": "false", "description": "Filtrar por cancha techada" },
                { "key": "activa", "value": "true", "description": "Filtrar por estado activo" },
                { "key": "_limit", "value": "10" },
                { "key": "_offset", "value": "0" }
              ]
            },
            "description": "Los filtros son opcionales; se pueden quitar desde Params."
          },
          "response": []
        },
        {
          "name": "Crear cancha",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cancha de fútbol 5\",\n  \"id_deporte\": 1,\n  \"precio_hora\": 1000000,\n  \"techada\": false,\n  \"activa\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/canchas",
            "description": "precio_hora está expresado en centavos."
          },
          "response": []
        },
        {
          "name": "Obtener cancha por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/canchas/{{idCancha}}"
          },
          "response": []
        },
        {
          "name": "Actualizar cancha",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio_hora\": 1200000,\n  \"techada\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/canchas/{{idCancha}}"
          },
          "response": []
        },
        {
          "name": "Eliminar cancha",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/canchas/{{idCancha}}",
            "description": "Solo se puede eliminar si no tiene reservas asociadas."
          },
          "response": []
        },
        {
          "name": "Consultar canchas disponibles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/canchas/disponibles?fecha=2026-10-15&hora_inicio=18:00:00&hora_fin=20:00:00&id_deporte=1&techada=false&_limit=10&_offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["canchas", "disponibles"],
              "query": [
                { "key": "fecha", "value": "2026-10-15" },
                { "key": "hora_inicio", "value": "18:00:00" },
                { "key": "hora_fin", "value": "20:00:00" },
                { "key": "id_deporte", "value": "1", "disabled": true },
                { "key": "techada", "value": "false", "disabled": true },
                { "key": "_limit", "value": "10", "disabled": true },
                { "key": "_offset", "value": "0", "disabled": true }
              ]
            },
            "description": "fecha, hora_inicio y hora_fin son obligatorios."
          },
          "response": []
        }
      ]
    },
    {
